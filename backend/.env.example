# ArchitectAI Environment Variables
# Copy this file to backend/.env and fill in your values

# Gemini API Keys (add 2 free-tier keys for double the daily quota)
GEMINI_API_KEY_1=your_first_gemini_key_here
GEMINI_API_KEY_2=your_second_gemini_key_here

# Fallback single key (optional, used if KEY_1 and KEY_2 not set)
GEMINI_API_KEY=your_gemini_key_here

# Server Port (optional, defaults to 3000)
PORT=3000
